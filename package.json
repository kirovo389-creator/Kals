{
  "name": "astra-workstation",
  "version": "0.1.0",
  "description": "Personal Windows launcher for an isolated OpenHands Agent Canvas workspace",
  "private": true,
  "license": "MIT",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "dev.astra.workstation",
    "productName": "Astra Workstation",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/starter",
        "to": "starter"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Astra Workstation",
      "artifactName": "Astra-Workstation-Setup-${version}.${ext}"
    }
  }
}
